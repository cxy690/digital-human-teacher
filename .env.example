# ===== 基础 =====
APP_NAME=education
ENV=local
DEBUG=true
LOG_LEVEL=INFO

# ===== 大模型（立项方案 3.4：Qwen3 私有化部署，OpenAI 兼容；留空则降级 Mock）=====
# LLM_PROVIDER=openai / qwen3（vLLM/SGLang 私有化，填本地端点与模型名）
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Qwen3 思考模式（直播场景建议 false 以降延迟）
LLM_ENABLE_THINKING=false

# ===== 意图识别小模型（agents/router：规则判不准 / 复杂·多意图时才调用）=====
# 常见输入（控制指令/闲聊/单一提问）走规则直判，不调模型，不占首响预算。
INTENT_LLM_ENABLE=true
# 空 = 沿用上面的 LLM_MODEL；可指向更小更快的模型以压延迟与成本
INTENT_LLM_MODEL=
INTENT_LLM_API_BASE=
INTENT_LLM_API_KEY=
# 超时即回退规则判定（不阻塞答疑）
INTENT_LLM_TIMEOUT_SECONDS=2.5
INTENT_LLM_MAX_TOKENS=160

# ===== 教师 Skill 自我更新（经验沉淀：core/skills/experience）=====
# 回合结束后异步复盘，把「可复用教学经验」沉淀进 data/teacher_experience/<老师key>.jsonl
# 并注入提示词；**不改写人格 Skill 本体**（core/skills/teacher_personality 由人维护）。
SKILL_SELF_UPDATE_ENABLE=true
SKILL_EXPERIENCE_DIR=data/teacher_experience
# 每次讲解最多注入几条经验（0=不注入）
SKILL_EXPERIENCE_INJECT_LIMIT=6
# 每位老师最多保留多少条生效经验。**0 = 不限（推荐）**：自动学到的经验不主动淘汰，
# 不会「学着学着把以前学的丢了」；提示词侧由上面的 INJECT_LIMIT 控制条数，不会撑大 prompt。
# 只有显式填正数时才会在超出后停用低分条目（仍不删文件，可 restore）。
SKILL_EXPERIENCE_MAX_ITEMS=0
SKILL_REFLECT_MAX_ITEMS=2
SKILL_REFLECT_MIN_CONFIDENCE=0.6
# 复盘节流（秒）：0=每次答疑都复盘；调大可省 LLM 开销
SKILL_REFLECT_MIN_INTERVAL_SECONDS=0.0

# ===== Agent 自主性（工具调用 / 自主规划 / ReAct 闭环，见 docs/agent_autonomy.md）=====
# 三项可独立关闭；任一关掉都退回「确定性流水线」，行为与加装前一致。
# 工具调用：把知识检索 / 解方程 / 验算 / OCR / 读白板 暴露给模型，由模型自己决定何时调用。
AGENT_TOOLS_ENABLE=true
AGENT_TOOL_MAX_CALLS=6
# ReAct 闭环：思考 -> 行动（调工具）-> 观察 -> 再思考，直到给出最终答复。
AGENT_REACT_ENABLE=true
AGENT_REACT_MAX_STEPS=4
AGENT_REACT_TIMEOUT_SECONDS=45
# 自主规划：回合开始先由模型产出「目标 + 步骤 + 建议工具 + 是否追问」。
AGENT_PLANNER_ENABLE=true
AGENT_PLANNER_TIMEOUT_SECONDS=6
AGENT_PLANNER_MAX_TOKENS=400

# ===== 长期记忆（学情记忆：错题 / 薄弱点 / 学习偏好，见 core/memory）=====
# 与「教师经验」正交：经验按老师存（老师会了什么），记忆按学生存（学生哪儿不会）。
MEMORY_ENABLE=true
MEMORY_DIR=data/memory
MEMORY_INJECT_LIMIT=5
# 单个学生最多保留多少条生效记忆。**0 = 不限（推荐）**：自动积累的学情不主动淘汰；
# 只有显式填正数时才会停用低分条目（要清空请用 DELETE /api/memory/{student_id}）。
MEMORY_MAX_ITEMS=0
# 用 LLM 从回合里蒸馏薄弱点：默认关（省额度），开启后按下面的秒数节流
MEMORY_DISTILL_ENABLE=false
MEMORY_DISTILL_MIN_INTERVAL_SECONDS=120

# 多模态视觉大模型（题目图片理解 / 圈画定位）
VLM_MODEL=gpt-4o

# ===== 实时语音 Agent（立项方案 3.3：ASR=FunASR，TTS=CosyVoice 3/2 / GPT-SoVITS）=====
# ASR_PROVIDER=openai / funasr / mock
ASR_PROVIDER=openai
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-1
# FunASR（中文课堂优，流式+VAD）
FUNASR_MODEL=paraformer-zh
FUNASR_HOTWORDS=
# TTS_PROVIDER=openai / edge / cosyvoice / gptsovits / mock
TTS_PROVIDER=openai
TTS_API_BASE=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
# 克隆音色参考干声（CosyVoice 3/2 / GPT-SoVITS zero-shot 克隆）
TTS_REF_AUDIO=
TTS_REF_TEXT=
COSYVOICE_API_BASE=
GPTSOVITS_API_BASE=

# ===== OCR =====
OCR_PROVIDER=paddle
OCR_CLOUD_KEY=

# ===== 实时通信 =====
HOST=0.0.0.0
PORT=8000
WEBSOCKET_PATH=/ws

# ===== 音视频 =====
RTC_PROVIDER=webrtc
RTC_APP_ID=
RTC_APP_SECRET=

# ===== 白板 / RAG =====
BOARD_SNAPSHOT_DIR=data/raw/board_snapshots
RAG_TOP_K=4

# ===== 编排引擎（builtin：自研 TaskGraph；langgraph：LangGraph StateGraph）=====
ORCHESTRATOR=builtin

# ===== 活动日志（节点到节点的图执行轨迹，见 core/activity_log.py）=====
# 默认关闭：逐节点记录量很大（连讲课件一页就有 4~5 条），排障时再打开。
# 落盘：<ACTIVITY_LOG_DIR>/activity/activity-<日期>.jsonl（append-only，按天滚动）
# 查看：python scripts/view_activity.py
ACTIVITY_LOG_ENABLE=false
ACTIVITY_LOG_DIR=logs
ACTIVITY_LOG_MAX_MB=20
ACTIVITY_LOG_KEEP_DAYS=7

# ===== 数字人（真实 TTS 音频 + 口型同步）=====
DIGITAL_HUMAN_ENABLE=true
DIGITAL_HUMAN_VISEME_ENABLE=true

# ===== 数字人渲染引擎（立项方案 3.1/3.2）=====
# L3 实时口型：mock（前端照片木偶，无需 GPU，默认）/ placeholder（静态图+音频占位视频）/ http / musetalk（MuseTalk1.5）/ latentsync
AVATAR_BACKEND=mock
AVATAR_API_BASE=
AVATAR_API_KEY=
AVATAR_TIMEOUT_SECONDS=60
# 老师肖像图（L1 离线渲染 HunyuanVideo/Hallo2 驱动用）
AVATAR_SOURCE_IMAGE=
# L3 MuseTalk 渲染帧率：必须与底片视频实际 fps 一致（data/raw/老师15s.mp4 默认 25）
# 传 30 而底片是 25 会导致画面加速/口型不同步
AVATAR_FPS=25
# L3 MuseTalk 人脸框上下平移：正值向下（多包下巴/脖子），负值向上（多包额头）
# 官方推荐区间 [-10, 10]；下巴被切用 -5，脖子入镜太多用 +3~+5
AVATAR_BBOX_SHIFT=-4
# L1 离线高质量渲染：mock / hunyuan（HunyuanVideo-Avatar）/ hallo2（Hallo2）
L1_AVATAR_BACKEND=mock
L1_AVATAR_API_BASE=
L1_AVATAR_API_KEY=
L1_AVATAR_TIMEOUT_SECONDS=600
# 引擎返回的视频是否自带音轨（真实引擎为 true）；false 时会额外下发 TTS 音频
AVATAR_VIDEO_HAS_AUDIO=true
# 无 TTS 音频时是否仍调用渲染服务（仅用于示例视频空跑链路，生产保持 false）
AVATAR_ALLOW_SILENT_AUDIO=false
# 每句 TTS 音频尾部追加的纯静音时长（秒）：让口型引擎以「闭嘴帧」收尾，切回待机底片更平滑；0=关闭
AVATAR_TAIL_SILENCE_SECONDS=0.6
# 单句视频落盘为 URL 由前端流式加载（避免大 base64 卡顿）；false=仍走 base64 下发
AVATAR_STREAM_URL_ENABLE=true

# ===== 数字人子服务（合并自 education_fusion：digital_human/，MuseTalk 口型 + WebRTC 推流）=====
# 与 AVATAR_BACKEND 正交：AVATAR_BACKEND 决定「后端逐句渲染视频」走哪条链路，
# 这里决定「是否启用/托管独立数字人子服务」（:8010，由 core/avatar_launcher.py 探活拉起）
AVATAR_ENABLE=false
# 数字人专用解释器（CUDA torch）；留空自动探测常见 conda 环境
AVATAR_PYTHON=
# 服务启动时自动拉起数字人子服务；云上/Linux 置 false（由外部脚本托管）
AVATAR_AUTOSTART=true
# 云上部署：数字人服务公网地址（学生端浏览器直连它拉 WebRTC）；留空按请求 Host 动态改写
AVATAR_PUBLIC_BASE=
# 未选学科时的兜底素材包；选定学科后按 data/curriculum/subjects.json 映射
# 合并约定：学科 key = 教师档案 key = avatar_id（数学=math、语文=chinese、科学=science）
AVATAR_ID=chinese
AVATAR_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 表情技能：学生答对时由 LLM 判定情境并下发表情贴纸（core/skills/expression_skill.py）
AVATAR_EXPRESSION_ENABLE=true

# ===== WebRTC ICE（数字人媒体流跨公网连接）=====
# 本机演示用默认 STUN；云上 NAT 后必须配 STUN，仍打不通再加 TURN 中继
RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# ===== AI 教师驱动视频源（换人只改这里）=====
# 主底片：放入 data/ai_teacher/talk.mp4 即可；缺失或校验不通过会自动回退
AI_TEACHER_VIDEO_PATH=data/ai_teacher/talk.mp4
# 回退底片：缺省与主底片同源，保证新素材未就绪时链路仍可跑通
AI_TEACHER_FALLBACK_PATH=data/ai_teacher/talk.mp4
# 动作基元库目录（talk/nod/shake/shrug/point.mp4，可选 idle.mp4）；引擎按此目录加载
AI_TEACHER_CLIP_DIR=data/ai_teacher
# 人脸预处理本地缓存根目录（按 video_hash 分子目录，换源自动失效）
AVATAR_CACHE_DIR=data/cache
# 校验阈值：分辨率最短边（像素，默认 512）；最低帧率（MuseTalk 标准 24fps）
AI_TEACHER_MIN_SIDE=512
AI_TEACHER_MIN_FPS=24

# ===== 多老师（11 科各一位老师：底片 + 标定 + 音色 + 说话风格）=====
# 教师档案目录：data/teachers/<学科key>/{talk.mp4, teacher.json, voice_ref.wav}
# 学科目录（含科目→数字人映射）：data/curriculum/subjects.json
# 说话风格/讲课深度/语速：config/teacher_skills/<学科key>.py
TEACHERS_DIR=data/teachers

# ===== 互动式追问（讲完题主动提问并等学生作答）=====
INTERACTION_ENABLE=true
INTERACTION_MAX_FOLLOWUPS=1
INTERACTION_MAX_RETRIES=2

# ===== 1v1 学科辅导课（学科选择页 -> 打招呼 -> 讲解+出题 -> 总结答疑）=====
COURSE_ENABLE=true
COURSE_DURATION_MINUTES=40
COURSE_QUIZ_ENABLE=true
# 出题节奏：讲解满多少分钟后才出第一道模拟题（默认 30）。
# 40 分钟一节课 = 讲解 30 分钟 + 出题/作答 10 分钟。0 = 旧的「讲完即出题」
COURSE_QUIZ_INTERVAL_MINUTES=30

# ===== 空闲主动问候（学生静默 N 秒后 AI 主动打招呼，并“对应上 AI 刚才问的问题”）=====
IDLE_NUDGE_ENABLE=true
IDLE_NUDGE_SECONDS=30
IDLE_NUDGE_MAX=3

# ===== 数据库（用户 / 学情存储；MySQL 优先）=====
# 生产请改成本机/内网地址与独立账号，密入口令管理，勿提交到仓库
DATABASE_URL=mysql+pymysql://root:change-me@localhost:3306/teacher?charset=utf8mb4
DB_ECHO=false

# ===== 真题库（数字人出题的真题来源；RAG 侧 MySQL 库）=====
# 出题优先从 ai_teacher.exercise_item 选真题（7/8/9 年级数学，有标准答案）；
# 库不可用/无匹配时自动回退 LLM 即兴出题，课堂不中断。测试环境自动关闭（conftest）。
EXERCISE_BANK_ENABLE=true
EXERCISE_BANK_URL=mysql+pymysql://root:change-me@localhost:3306/ai_teacher?charset=utf8mb4
EXERCISE_BANK_TYPES=choice,fill
EXERCISE_BANK_MAX_STEM_CHARS=160
EXERCISE_BANK_ALLOW_REVIEW=false
EXERCISE_BANK_SKIP_FIGURE=true

# ===== 身份认证（见 core/auth、db/models）=====
AUTH_ENABLE=true
# true = 未登录一律拒绝（WS 硬门禁）；false = 灰度（带了 token 才校验，否则按匿名）
AUTH_REQUIRED=false
AUTH_ALLOW_REGISTER=true
# JWT 签名密钥：生产必须替换为随机长串
AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL_MINUTES=720
# 启动时预置演示账号（student/parent/teacher/admin，密码均 123456）
AUTH_SEED_DEMO=true
# 允许的跨域来源（逗号分隔）；* = 不限制
CORS_ALLOW_ORIGINS=*

# ===== 防逆向 / 防盗用 =====
ANTI_REV_SECRET=dev-secret-change-me
RATE_LIMIT_PER_MIN=240


# ===========================================================================
# ===== 融合新增（自 education 云端分叉合入）：可观测 / 治理 / 检索 / 阈值 =====
# ===========================================================================
# 以下每一项都对应本次融合合入的能力，留空/注释即回到融合前的行为。

# ----- 日志落盘（config/logging.py）-----
# 日志同时进 stderr 与 logs/app.log；只写 stderr 的话，本地跑完关掉终端就没了现场。
LOG_DIR=logs
LOG_ROTATE=00:00
LOG_MAX_TOTAL_MB=200
LOG_MAX_FILES=90
LOG_KEEP=30 days

# ----- 模型输出上限 -----
# 答疑要一次产出 speech + 4~6 步板书 + 知识点 + 易错点 + 追问，截断的后果不是话短而是
# JSON 不闭合 -> 整块降级 -> 白板全空。1800 是实测够用的上限（不是目标值）。
LLM_MAX_TOKENS=3072
ANSWER_MAX_TOKENS=1800

# ----- 回合调用链日志（core/trace.py）-----
# 每次学生输入会多打一条 INFO：这次经过了哪些函数、各花多少毫秒。排障神器。
TRACE_ENABLE=true
TRACE_SHOW_MS=false

# ----- 回合裁决落盘（core/verdict.py，L0 观测层）-----
# 把 JSON 降级 / 质检扣分 / 调用链异常 / 总耗时追加进当天 JSONL；上层健康画像、
# 失败聚类、经验收益回写都读它。没有它就无法回答「系统在变好还是变坏」。
VERDICT_ENABLE=true
VERDICT_DIR=data/raw/verdicts
VERDICT_WINDOW_DAYS=7
VERDICT_KEEP_DAYS=30
VERDICT_KEEP_STEPS=true

# ----- 失败聚类与根因分析（core/failure_cluster.py，L3）-----
# 聚类是纯统计、永久可用；这里控制的是「要花一次模型调用」的根因分析段。
FAILURE_ANALYSIS_ENABLE=true
FAILURE_ANALYSIS_MAX_TOKENS=700

# ----- 安全事件审计（core/safety_audit.py，面向未成年人合规）-----
# 危机/敏感命中落盘 JSONL，只追加。push_event 只到当前连接，没人在线就等于没上报。
SAFETY_AUDIT_ENABLE=true
SAFETY_AUDIT_PATH=data/raw/safety_events.jsonl

# ----- 经验层 L2/L5（core/skills/experience）-----
# bandit：按实测收益的后验采样决定注入哪几条（关掉回到 hits*confidence 静态排序）。
# feedback：把回合裁决回写成经验的战绩（关掉则 bandit 永远没有奖励信号）。
SKILL_EXPERIENCE_BANDIT_ENABLE=true
SKILL_EXPERIENCE_FEEDBACK_ENABLE=true

# ----- 检索后端与向量检索（rag/retriever.py、rag/embedding.py）-----
# auto = 配了 EMBEDDING_API_BASE 就用向量，否则词法 bigram；也可强制 vector / keyword。
RAG_BACKEND=auto
# Embedding 服务（OpenAI 兼容 /v1/embeddings）；留空即用词法检索。
# 例：云端私有化 http://127.0.0.1:8101/v1（见 scripts/embedding_server.py）
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30
# 索引目录：python scripts/build_rag_index.py 生成；启动时加载，不在线重建。
RAG_INDEX_DIR=data/raw/rag_index

# ----- 语音合成语速与豆包引擎（models/tts.py）-----
# 全局语速系数（<1 变慢 / >1 变快，变速不变调）；零样本克隆会模仿参考干声语速，
# 各老师快慢不一，这里统一校准。允许范围 0.5~2.0。
TTS_SPEED=1.0
# TTS_PROVIDER=doubao 时生效（火山引擎 v3 单向流式；鉴权只认 API Key）
DOUBAO_API_KEY=
DOUBAO_API_BASE=https://openspeech.bytedance.com
DOUBAO_RESOURCE_ID=volc.service_type.10029
DOUBAO_CLONE_RESOURCE_ID=seed-icl-2.0
DOUBAO_SPEAKER=zh_female_shuangkuaisisi_moon_bigtts
# 按老师分派豆包复刻音色：math=S_abc123,chinese=S_def456
DOUBAO_TEACHER_SPEAKERS=

# ----- 运行时写库（db/runtime_sync.py）-----
# 会话落盘（检查点）时同步镜像进数据库，Navicat 里可直接看；写库在后台线程，失败只告警。
# auto = 仅当 DATABASE_URL 是 MySQL 时启用；on / off 可强制。
RUNTIME_DB_WRITE=auto
