# ============================================================================
# 算力云部署配置模板（单机多服务，端点全部指向本机 localhost）
# 用法：在云主机项目根目录  cp deploy/cloud/env.cloud.example .env  后按需微调
# 注意：本文件所有「值行」都不带行内注释（python-dotenv 会把空值后的 # 注释当成值）
# ============================================================================
APP_NAME=education
ENV=prod
DEBUG=false
LOG_LEVEL=INFO

# ===== 教学大脑：三种形态，任选其一 =====
# ① 在线 API（默认推荐·质量优先·不占显存）：LLM_PROVIDER=openai + 官方端点
#    bash deploy/cloud/switch_mode.sh online   即可自动写入（片段见 mode_online.env）
# ② 本地 AWQ（离线·断网可用）：LLM_PROVIDER=qwen3 + LLM_API_BASE=http://127.0.0.1:8100/v1
#    由 scripts/llm_engine_local.py 提供服务；bash deploy/cloud/switch_mode.sh offline 自动拉起
# ③ 本地 vLLM（可选·默认关闭）：需 ENABLE_QWEN3=1 bash deploy/cloud/start_all.sh 才会起 :8100
# 本地私有化 API_KEY 填 EMPTY/local（非空即可，勿留空否则降级 MockLLM）
LLM_PROVIDER=qwen3
LLM_API_BASE=http://127.0.0.1:8100/v1
LLM_API_KEY=EMPTY
# 显存选模：本地 AWQ 用 Qwen3-8B-AWQ / Qwen2.5-7B-AWQ；vLLM 用 Qwen3-8B(FP16) 或 Qwen3-4B
LLM_MODEL=Qwen3-8B
LLM_TIMEOUT_SECONDS=60
LLM_ENABLE_THINKING=false
VLM_MODEL=Qwen3-VL

# ===== ASR：FunASR（scripts/asr_engine_funasr.py，:10095）=====
# 引擎默认加载 iic/SenseVoiceSmall（自带 VAD/标点，约 0.3s/句）；
# 如需 paraformer-zh 则引擎会另挂 fsmn-vad + ct-punc 子模型。
ASR_PROVIDER=funasr
ASR_API_BASE=http://127.0.0.1:10095
ASR_API_KEY=
ASR_MODEL=whisper-1
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_HOTWORDS=

# ===== TTS：CosyVoice 3（scripts/tts_engine_cosyvoice.py，:8090；兼容 CosyVoice2）=====
TTS_PROVIDER=cosyvoice
COSYVOICE_API_BASE=http://127.0.0.1:8090
GPTSOVITS_API_BASE=
TTS_API_KEY=
TTS_MODEL=cosyvoice3
TTS_VOICE=
# 多老师音色克隆：**无需在此填写**。每位老师的参考干声与文本由
# data/teachers/<学科key>/voice_ref.wav + teacher.json 的 voice_ref_text 自动提供，
# 后端按当前学科（teacher_id）逐句切换音色。此处仅在需要「全局兜底音色」时才填。
TTS_REF_AUDIO=
TTS_REF_TEXT=

# ===== OCR / 编排 =====
OCR_PROVIDER=paddle
OCR_CLOUD_KEY=
ORCHESTRATOR=langgraph

# ===== 服务端口 / 实时通信 =====
HOST=0.0.0.0
PORT=8001
WEBSOCKET_PATH=/ws
RTC_PROVIDER=webrtc
RTC_APP_ID=
RTC_APP_SECRET=

# ===== 存储 / 检索 =====
BOARD_SNAPSHOT_DIR=data/raw/board_snapshots
RAG_TOP_K=4

# ===== 数字人 L3 实时：MuseTalk 1.5（scripts/avatar_engine_musetalk_v15.py，:8012）=====
# 下面两个键名里的 DIGITAL_HUMAN 指「数字人口型所需的音频/视素下发」，与已清理的
# digital_human/ 子服务无关（那条 WebRTC 路线已随合并清理移除）。
DIGITAL_HUMAN_ENABLE=true
DIGITAL_HUMAN_VISEME_ENABLE=true
# 可选：musetalk（推荐）/ placeholder（无 GPU 时静态图+音频占位）/ mock / http / latentsync
AVATAR_BACKEND=musetalk
AVATAR_API_BASE=http://127.0.0.1:8012
AVATAR_API_KEY=
AVATAR_TIMEOUT_SECONDS=60
# 老师肖像/底片图，放到云主机可访问路径
AVATAR_SOURCE_IMAGE=
# MuseTalk 渲染帧率：必须与底片视频实际 fps 一致（data/raw 基元库 talk/nod/shake/shrug/point.mp4 均为 24）
AVATAR_FPS=24
# MuseTalk 人脸框上下平移（正下负上，官方推荐 [-10, 10]）；下巴被切用 -5
AVATAR_BBOX_SHIFT=-4
# 动作基元库目录（主底片 talk.mp4 + 手势 nod/shake/shrug/point.mp4）；缺省为 data/raw
# AVATAR_CLIP_DIR=/root/education/education/data/raw
# 手势 <-> 主底片 交叉淡化帧数（越大越丝滑但过渡越慢，0=直接切）
# MUSETALK_CROSSFADE=6
AVATAR_VIDEO_HAS_AUDIO=true
AVATAR_ALLOW_SILENT_AUDIO=false

# ===== AI 教师驱动视频源（多老师：形象一律来自 data/teachers/<学科key>/talk.mp4）=====
# 主底片：仅在「无法按学科确定老师」时作为兜底；实际课堂由 /api/teacher 按学科下发该老师底片
AI_TEACHER_VIDEO_PATH=data/teachers/chinese/talk.mp4
# 回退底片：同上，不再指向任何旧的 底片.mp4
AI_TEACHER_FALLBACK_PATH=data/teachers/chinese/talk.mp4
# 旧单底片覆盖：**留空**（多老师模式下由 teacher_id 决定底片，见 AVATAR_TEACHERS_DIR）
AVATAR_FACE_VIDEO=
# 引擎素材目录（多老师：每个学科一个子目录）
AI_TEACHER_CLIP_DIR=data/teachers
# 人脸预处理本地缓存根目录（按 video_hash 分子目录，换源自动失效）
AVATAR_CACHE_DIR=data/cache
# 校验阈值：分辨率最短边（像素，默认 512）；最低帧率（MuseTalk 标准 24fps）
AI_TEACHER_MIN_SIDE=512
AI_TEACHER_MIN_FPS=24

# ===== 多老师（每位老师 = 一个学科；底片放在 data/teachers/<学科key>/）=====
# 引擎按 /render 的 teacher_id 懒加载对应底片；关闭旧单底片预加载可省显存与启动时间
AVATAR_TEACHERS_DIR=data/teachers
AVATAR_LEGACY_PRELOAD=0
# 同时常驻的教师底片数（LRU 淘汰，按并发学科数调整）
MUSETALK_MAX_TEACHERS=2

# ===== 白板先行 / 讲课风格 =====
# off / single_call（方案B·单次调用）/ two_call（方案A·两次调用）
BOARD_FIRST_MODE=single_call
# plain（大白话·通俗易懂，推荐中小学）/ normal（按学段默认）/ academic（规范术语）
TEACHING_STYLE=plain

# ===== 教学护栏与合规（面向未成年人）=====
GUARDRAIL_ENABLE=true
GUARDRAIL_SUBJECT=
GUARDRAIL_GRADE=
CONTENT_SAFETY_ENABLE=true
AI_CONTENT_WATERMARK_ENABLE=true

# ===== 互动 / 防逆向 =====
INTERACTION_ENABLE=true
INTERACTION_MAX_FOLLOWUPS=1
INTERACTION_MAX_RETRIES=2
ANTI_REV_SECRET=change-me-in-prod
RATE_LIMIT_PER_MIN=240
