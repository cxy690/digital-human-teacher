# 在线答疑大脑（DeepSeek API）配置片段模板
#
# 用法：cp deploy/cloud/mode_online.env.example deploy/cloud/mode_online.env
#      然后填入自己的 LLM_API_KEY，再执行 bash deploy/cloud/switch_mode.sh online
# 说明：mode_online.env 含明文密钥，已被 .gitignore 忽略，请勿提交到版本库。
LLM_PROVIDER=openai
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_ENABLE_THINKING=false
# DeepSeek V4 默认开思考：推理 token 占 max_tokens 且首响延迟翻倍，课堂场景关闭
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
